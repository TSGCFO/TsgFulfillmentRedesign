.spider_5 { right: 5%; margin-top: 210px; animation: 5s ease 0s infinite normal none running spider-move-5; }

@keyframes legs-wriggle-right { 
  0%, 100% { transform: rotate(-36deg) skewX(20deg); }
  25%, 75% { transform: rotate(-15deg) skewX(20deg); }
  50% { transform: rotate(-45deg) skewX(20deg); }
}

@keyframes legs-wriggle-left { 
  0%, 100% { transform: rotate(36deg) skewX(-20deg); }
  25%, 75% { transform: rotate(15deg) skewX(-20deg); }
  50% { transform: rotate(45deg) skewX(-20deg); }
}

@keyframes spider-move-0 { 
  0%, 100% { margin-top: 213px; }
  47% { margin-top: 243px; }
}

@keyframes spider-move-1 { 
  0%, 100% { margin-top: 69px; }
  54% { margin-top: 179px; }
}

@keyframes spider-move-2 { 
  0%, 100% { margin-top: 118px; }
  58% { margin-top: 150px; }
}

@keyframes spider-move-3 { 
  0%, 100% { margin-top: 50px; }
  63% { margin-top: 93px; }
}

@keyframes spider-move-4 { 
  0%, 100% { margin-top: 93px; }
  31% { margin-top: 165px; }
}

@keyframes spider-move-5 { 
  0%, 100% { margin-top: 170px; }
  52% { margin-top: 239px; }
}

.mobile-page { background-color: rgb(245, 248, 250); }

.mobile-page .wsg-container { flex: 1 0 auto; }

