[class*="spider"] .leg.left { left: -8px; transform-origin: right top; transform: rotate(36deg) skewX(-20deg); border-left: 2px solid rgb(17, 13, 4); border-radius: 90% 0px 0px; animation: 1s ease 0s infinite normal none running legs-wriggle-left; }

