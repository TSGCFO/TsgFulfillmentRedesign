.mobile-page h3 { color: rgb(51, 51, 51); }

.mobile-page .subtitle { color: rgb(51, 71, 91); }

.mobile-page .mobile-card-flow { display: flex; justify-content: flex-end; flex-direction: row; }

.mobile-page .preview { top: 30px; margin-bottom: 20px; margin-right: 20px; }

