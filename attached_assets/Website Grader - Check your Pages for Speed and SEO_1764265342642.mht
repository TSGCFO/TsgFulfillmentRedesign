.overall-page { color: rgb(255, 255, 255); position: relative; background-color: rgb(245, 248, 250); }

.overall-page .wsg-container { margin-top: 80px; display: flex; flex-direction: column; align-items: center; }

@media only screen and (max-width: 768px) {
